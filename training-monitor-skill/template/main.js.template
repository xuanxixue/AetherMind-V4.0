// main.js - {{MODEL_NAME}} Training Monitor (generated)
const { app, BrowserWindow, ipcMain, dialog } = require('electron');
const path = require('path');
const fs = require('fs');
const { exec } = require('child_process');

let mainWindow = null;
let nextSessionId = 1;
const sessions = new Map();
let gpuMonitorTimer = null;

// === 指标定义（从配置生成）===
const RE = {
{{METRICS_REGEX}}
};

const metrics = { running: false, phase: '?', step: 0, total: 0, loss: 0, lr: 0, sps: 0, bad: 0, tau: 0, cons: 0, physics_ratio: 0, dominance: '?', nan_detected: false, tau_high: false, grad_ratio: 0, compression_kl: 0, kl_warning: false, gpu_used: 0, gpu_total: 4096, gpu_pct: 0, wd_clear: 0, wd_emerg: 0, eta: '?' };
const curveData = { {{CURVE_KEYS}} };
const MAX_POINTS = 400;

function parseBuffer(text) {
  for (const [key, regex] of Object.entries(RE)) {
    try {
      const gre = new RegExp(regex.source, 'g');
      const matches = [...text.matchAll(gre)];
      if (matches.length === 0) continue;
      const m = matches[matches.length - 1];
      if (key === 'phase') metrics.phase = m[1] || m[2] || metrics.phase;
      else if (key === 'step') {
        if (m[1]) { metrics.step = parseInt(m[1]); metrics.total = parseInt(m[2]); }
        else if (m[3]) { metrics.step = parseInt(m[3]); metrics.total = parseInt(m[4]); }
      } else if (key === 'dominance') {
        if (text.includes('->') && (text.includes('dominant')||text.includes('mixed')||text.includes('significant')))
          metrics.dominance = m[1];
      } else if (key === 'kl') {
        if (text.includes('平移不变假设失效') || text.includes('migration')) { metrics.kl_warning = true; metrics.compression_kl = parseFloat(m[1]); }
      } else if (key === 'eta') {
        metrics.eta = m[1];
      } else {
        const val = parseFloat(m[1]);
        if (!isNaN(val)) metrics[key] = val;
      }
    } catch(e) {}
  }
  if (text.toLowerCase().includes('nan') && text.toLowerCase().includes('loss')) metrics.nan_detected = true;
}

function pushCurvePoint() {
{{CURVE_PUSH}}
  for (const k of Object.keys(curveData)) {
    if (curveData[k].length > MAX_POINTS) curveData[k].shift();
  }
}

function queryGpuMemory() {
  return new Promise((resolve) => {
    exec('nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits',
      { timeout: 5000, encoding: 'utf-8' },
      (err, stdout) => {
        if (err) { resolve([0, 4096]); return; }
        const parts = stdout.trim().split(',');
        if (parts.length >= 2) resolve([parseInt(parts[0].trim()), parseInt(parts[1].trim())]);
        else resolve([0, 4096]);
      }
    );
  });
}

async function gpuMonitorLoop() {
  const [used, total] = await queryGpuMemory();
  metrics.gpu_used = used; metrics.gpu_total = total;
  metrics.gpu_pct = total > 0 ? used / total : 0;
  if (mainWindow && !mainWindow.isDestroyed()) {
    mainWindow.webContents.send('gpu-update', { used, total, pct: metrics.gpu_pct });
  }
}

function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1400, height: 900, minWidth: 1100, minHeight: 700,
    backgroundColor: '#1a1a2e',
    title: '{{WINDOW_TITLE}}',
    webPreferences: { preload: path.join(__dirname, 'preload.js'), contextIsolation: true, nodeIntegration: false },
    autoHideMenuBar: true, show: false
  });
  mainWindow.loadFile(path.join(__dirname, 'renderer', 'index.html'));
  mainWindow.once('ready-to-show', () => mainWindow.show());
  gpuMonitorTimer = setInterval(gpuMonitorLoop, 2000);
  gpuMonitorLoop();
}

function createSession(cmdArgs, label) {
  const id = nextSessionId++;
  const projectRoot = '{{PROJECT_ROOT}}';
  const isCmd = cmdArgs[0] && (cmdArgs[0].endsWith('.cmd') || cmdArgs[0].endsWith('.bat'));
  let shell, args;
  if (isCmd) { shell = 'cmd.exe'; args = ['/c', ...cmdArgs]; }
  else { shell = process.platform === 'win32' ? 'python.exe' : 'python3'; args = cmdArgs; }
  try {
    const pty = require('node-pty');
    const proc = pty.spawn(shell, args, {
      name: 'xterm-color', cols: 120, rows: 30, cwd: projectRoot,
      env: { ...process.env, HF_HUB_OFFLINE: '1', PYTORCH_CUDA_ALLOC_CONF: 'max_split_size_mb:128' }
    });
    const session = { pty: proc, label, buffer: '', pointCounter: 0 };
    sessions.set(id, session);
    metrics.running = true;
    proc.onData((data) => {
      session.buffer += data;
      if (session.buffer.length > 500000) session.buffer = session.buffer.slice(-300000);
      if (mainWindow && !mainWindow.isDestroyed()) mainWindow.webContents.send('pty-data', { id, data });
      session.pointCounter++;
      if (session.pointCounter % 3 === 0) {
        parseBuffer(session.buffer.slice(-4000));
        pushCurvePoint();
        if (mainWindow && !mainWindow.isDestroyed()) mainWindow.webContents.send('metrics-update', { ...metrics, curves: { ...curveData } });
      }
    });
    proc.onExit(() => {
      if (mainWindow && !mainWindow.isDestroyed()) mainWindow.webContents.send('session-exit', { id });
      sessions.delete(id);
      if (sessions.size === 0) metrics.running = false;
    });
    return { ok: true, id, label };
  } catch (e) { return { ok: false, msg: e.message }; }
}

ipcMain.handle('session-create', (e, cmdArgs, label) => createSession(cmdArgs, label || 'Session'));
ipcMain.handle('session-close', (e, id) => { const s = sessions.get(id); if (s) { try { s.pty.kill(); } catch {} sessions.delete(id); } if (sessions.size === 0) metrics.running = false; return { ok: true }; });
ipcMain.handle('session-switch', (e, id) => { const s = sessions.get(id); return { ok: true, buffer: s ? s.buffer : '' }; });
ipcMain.handle('pty-input', (e, id, data) => { const s = sessions.get(id); if (s) { s.pty.write(data); return { ok: true }; } return { ok: false }; });
ipcMain.handle('pty-resize', (e, id, cols, rows) => { const s = sessions.get(id); if (s) { try { s.pty.resize(cols, rows); } catch {} } });
ipcMain.handle('log-download', async (e, id) => {
  const s = sessions.get(id);
  if (!s || !s.buffer) return { ok: false, msg: 'No log data' };
  const result = await dialog.showSaveDialog(mainWindow, { title: 'Save Log', defaultPath: 'training_log.txt', filters: [{ name: 'Text', extensions: ['txt'] }] });
  if (result.canceled) return { ok: false, msg: 'Cancelled' };
  fs.writeFileSync(result.filePath, s.buffer, 'utf-8');
  return { ok: true, path: result.filePath };
});
ipcMain.handle('get-metrics', () => ({ ...metrics, curves: { ...curveData } }));

app.whenReady().then(createWindow);
app.on('window-all-closed', () => { if (gpuMonitorTimer) clearInterval(gpuMonitorTimer); app.quit(); });
